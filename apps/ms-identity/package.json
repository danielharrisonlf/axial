    "@nestjs/platform-express": "12.3.3",
    "better-auth": "1.7.20",
    "dotenv": "16.6.1",
    "jose": "6.2.15",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
