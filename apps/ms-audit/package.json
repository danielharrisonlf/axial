{
  "name": "@axial/ms-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed-demo.ts",
    "db:seed:test": "tsx src/seed-demo.ts --test",
    "test:unit": "vitest run",
    "test:integration": "node test/integration.mjs && node test/seed.mjs"
  },
  "dependencies": {
    "@axial/contracts": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "bullmq": "5.81.5",
    "compression": "1.8.1",
    "dotenv": "16.6.1",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axial/demo-fixtures": "workspace:*",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
