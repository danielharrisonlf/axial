    "@nestjs/platform-express": "12.3.3",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
