{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/generated",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!**/output",
      "!**/.mf",
      "!apps/web/src/styles/prototype.css",
      "!apps/web/src/data/demo-seed.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "error" } }
  },
  "overrides": [
    {
      "includes": ["apps/insights/src/**/*.vue"],
      "linter": {
        "rules": { "correctness": { "noUnusedVariables": "off" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
