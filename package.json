{
  "name": "axial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axial - plataforma interna de gestao de projetos",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @axial/ms-projects test:integration",
    "test:e2e": "pnpm --filter @axial/ms-projects test:e2e",
    "test:web:e2e": "pnpm --filter @axial/web test:e2e",
    "dev:web": "pnpm --filter @axial/web dev",
    "dev:api": "pnpm --filter @axial/ms-projects dev",
    "db:generate": "pnpm --filter @axial/ms-projects db:generate",
    "db:migrate": "pnpm --filter @axial/ms-projects db:migrate",
    "db:seed": "pnpm --filter @axial/ms-projects db:seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "dev:keys": "node scripts/dev-identity.mjs init",
    "dev:token": "node scripts/dev-identity.mjs token"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "2.11.3",
    "typescript": "catalog:"
  }
}
