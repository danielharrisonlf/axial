{
  "name": "axial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Axial - plataforma interna de gestao de projetos",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@axial/ms-projects --filter=@axial/web --filter=@axial/insights",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @axial/ms-projects test:integration",
    "test:e2e": "pnpm --filter @axial/ms-projects test:e2e",
    "test:identity:integration": "pnpm --filter @axial/ms-identity test:integration",
    "test:identity:interop": "pnpm --filter @axial/ms-identity test:interop",
    "test:realtime:integration": "pnpm --filter @axial/ms-realtime test:integration",
    "test:notifications:integration": "pnpm --filter @axial/ms-notifications test:integration",
    "test:web:e2e": "pnpm --filter @axial/web test:e2e",
    "dev:web": "pnpm --filter @axial/contracts build && pnpm --filter @axial/web dev",
    "dev:api": "pnpm --filter @axial/contracts build && pnpm --filter @axial/ms-projects dev",
    "dev:identity": "pnpm --filter @axial/ms-identity dev",
    "dev:realtime": "pnpm --filter @axial/contracts build && pnpm --filter @axial/ms-realtime dev",
    "dev:notifications": "pnpm --filter @axial/ms-notifications dev",
    "db:notifications:migrate": "pnpm --filter @axial/ms-notifications db:migrate",
    "db:identity:migrate": "pnpm --filter @axial/ms-identity db:migrate",
    "db:generate": "pnpm --filter @axial/ms-projects db:generate",
    "db:migrate": "pnpm --filter @axial/ms-projects db:migrate",
    "db:seed": "pnpm --filter @axial/ms-projects db:seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "dev:keys": "node scripts/dev-identity.mjs init",
    "dev:token": "node scripts/dev-identity.mjs token",
    "dev:gateway": "pnpm --filter @axial/gateway dev",
    "dev:mcp": "pnpm --filter @axial/mcp-server dev",
    "dev:audit": "pnpm --filter @axial/contracts build && pnpm --filter @axial/ms-audit dev",
    "dev:insights": "pnpm --filter @axial/insights dev",
    "db:audit:migrate": "pnpm --filter @axial/ms-audit db:migrate",
    "test:gateway:integration": "pnpm --filter @axial/gateway test:integration",
    "test:mcp:integration": "pnpm --filter @axial/mcp-server test:integration",
    "test:audit:integration": "pnpm --filter @axial/ms-audit test:integration",
    "perf": "node scripts/performance/run.mjs all",
    "perf:stack": "node scripts/performance/run.mjs stack",
    "perf:stop": "node scripts/performance/run.mjs stop",
    "perf:load": "node scripts/performance/run.mjs load",
    "perf:web": "node scripts/performance/run.mjs web",
    "perf:lighthouse": "node scripts/performance/run.mjs lighthouse",
    "perf:report": "node scripts/performance/run.mjs report"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "autocannon": "9.0.0",
    "lighthouse": "13.6.0",
    "turbo": "2.11.3",
    "typescript": "catalog:"
  }
}
