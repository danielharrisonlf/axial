{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "PORT",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "JWT_PUBLIC_KEY_PATH",
    "JWT_JWKS_URL",
    "RELAY_ENABLED",
    "RELAY_POLL_MS",
    "CORS_ORIGINS",
    "IDENTITY_DATABASE_URL",
    "IDENTITY_TEST_DATABASE_URL",
    "IDENTITY_PRIVATE_KEY_PATH",
    "IDENTITY_PUBLIC_KEY_PATH",
    "IDENTITY_ISSUER",
    "IDENTITY_AUDIENCE",
    "IDENTITY_PORT",
    "REALTIME_PORT",
    "REALTIME_NAMESPACE",
    "PROJECTS_API_URL",
    "NOTIFICATIONS_DATABASE_URL",
    "NOTIFICATIONS_REDIS_URL",
    "NOTIFICATIONS_PUBLIC_KEY_PATH",
    "NOTIFICATIONS_JWT_ISSUER",
    "NOTIFICATIONS_JWT_AUDIENCE",
    "NOTIFICATIONS_PORT",
    "NOTIFICATIONS_PROVIDER_URL",
    "NOTIFICATIONS_PROVIDER_TOKEN",
    "NOTIFICATIONS_TRUST_EXTERNAL_VERIFICATION",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "SMSGO_API_KEY",
    "SMSGO_SMS_TYPE_ID",
    "SMSGO_VERIFICATION_SMS_TYPE_ID",
    "META_ACCESS_TOKEN",
    "META_PHONE_NUMBER_ID",
    "META_TEMPLATE_NAME",
    "META_LANGUAGE_CODE",
    "META_GRAPH_VERSION",
    "NOTIFICATIONS_VERIFICATION_PEPPER",
    "NOTIFICATIONS_VERIFY_EMAIL",
    "NOTIFICATIONS_VERIFY_SMS",
    "NOTIFICATIONS_VERIFY_WHATSAPP",
    "META_VERIFICATION_TEMPLATE_NAME",
    "META_VERIFICATION_LANGUAGE_CODE",
    "META_VERIFICATION_TEMPLATE_MODE",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "IDENTITY_TRUSTED_ORIGINS",
    "AUDIT_PORT",
    "AUDIT_DATABASE_URL",
    "AUDIT_REDIS_URL",
    "AUDIT_PUBLIC_KEY_PATH",
    "AUDIT_JWT_ISSUER",
    "AUDIT_JWT_AUDIENCE",
    "MCP_PORT",
    "MCP_RESOURCE",
    "MCP_PUBLIC_KEY_PATH",
    "MCP_JWKS_URL",
    "MCP_JWT_ISSUER",
    "MCP_JWT_AUDIENCE",
    "MCP_ALLOWED_ORIGINS",
    "GATEWAY_PORT",
    "IDENTITY_API_URL",
    "NOTIFICATIONS_API_URL",
    "REALTIME_API_URL",
    "AUDIT_API_URL",
    "MCP_API_URL",
    "GATEWAY_CORS_ORIGINS",
    "INSIGHTS_REMOTE_ENTRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
