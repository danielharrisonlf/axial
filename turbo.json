{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "PORT",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "JWT_PUBLIC_KEY_PATH",
    "JWT_JWKS_URL",
    "RELAY_ENABLED",
    "RELAY_POLL_MS",
    "CORS_ORIGINS",
    "IDENTITY_DATABASE_URL",
    "IDENTITY_TEST_DATABASE_URL",
    "IDENTITY_PRIVATE_KEY_PATH",
    "IDENTITY_PUBLIC_KEY_PATH",
    "IDENTITY_ISSUER",
    "IDENTITY_AUDIENCE",
    "IDENTITY_PORT",
    "REALTIME_PORT",
    "REALTIME_NAMESPACE",
    "PROJECTS_API_URL",
    "NOTIFICATIONS_DATABASE_URL",
    "NOTIFICATIONS_REDIS_URL",
    "NOTIFICATIONS_PUBLIC_KEY_PATH",
    "NOTIFICATIONS_JWT_ISSUER",
    "NOTIFICATIONS_JWT_AUDIENCE",
    "NOTIFICATIONS_PORT",
    "NOTIFICATIONS_PROVIDER_URL",
    "NOTIFICATIONS_PROVIDER_TOKEN",
    "NOTIFICATIONS_TRUST_EXTERNAL_VERIFICATION",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "SMSGO_API_KEY",
    "SMSGO_SMS_TYPE_ID",
    "SMSGO_VERIFICATION_SMS_TYPE_ID",
    "META_ACCESS_TOKEN",
    "META_PHONE_NUMBER_ID",
    "META_TEMPLATE_NAME",
    "META_LANGUAGE_CODE",
    "META_GRAPH_VERSION",
    "NOTIFICATIONS_VERIFICATION_PEPPER",
    "NOTIFICATIONS_VERIFY_EMAIL",
    "NOTIFICATIONS_VERIFY_SMS",
    "NOTIFICATIONS_VERIFY_WHATSAPP",
    "META_VERIFICATION_TEMPLATE_NAME",
    "META_VERIFICATION_LANGUAGE_CODE",
    "META_VERIFICATION_TEMPLATE_MODE"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test:unit": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
