NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://axial:axial_local_only@localhost:5549/axial_dev?schema=projects
TEST_DATABASE_URL=postgresql://axial:axial_local_only@localhost:5550/axial_test?schema=projects
REDIS_URL=redis://localhost:6389
TEST_REDIS_URL=redis://localhost:6389/15
JWT_ISSUER=http://localhost:3000/identity
JWT_AUDIENCE=axial-projects
JWT_PUBLIC_KEY_PATH=../../keys/dev-public.pem
RELAY_ENABLED=true
RELAY_POLL_MS=1000
CORS_ORIGINS=http://localhost:5173

# --- ms-identity (BetterAuth) ---
IDENTITY_PORT=3002
IDENTITY_DATABASE_URL=postgresql://axial:axial_local_only@localhost:5549/axial_dev
BETTER_AUTH_SECRET=development-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3002
IDENTITY_TRUSTED_ORIGINS=http://localhost:5173
IDENTITY_ISSUER=http://localhost:3000/identity
IDENTITY_AUDIENCE=axial-projects
IDENTITY_PRIVATE_KEY_PATH=../../keys/dev-private.pem
IDENTITY_PUBLIC_KEY_PATH=../../keys/dev-public.pem

# --- ms-audit ---
AUDIT_PORT=3005
AUDIT_DATABASE_URL=postgresql://axial:axial_local_only@localhost:5549/axial_dev
AUDIT_REDIS_URL=redis://localhost:6389
AUDIT_PUBLIC_KEY_PATH=../../keys/dev-public.pem
AUDIT_JWT_ISSUER=http://localhost:3000/identity
AUDIT_JWT_AUDIENCE=axial-projects

# --- mcp-server ---
MCP_PORT=3006
MCP_RESOURCE=http://localhost:3006/mcp
MCP_PUBLIC_KEY_PATH=../../keys/dev-public.pem
MCP_JWT_ISSUER=http://localhost:3000/identity
MCP_JWT_AUDIENCE=axial-projects
PROJECTS_API_URL=http://localhost:3001
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- gateway ---
GATEWAY_PORT=3000
IDENTITY_API_URL=http://localhost:3002
NOTIFICATIONS_API_URL=http://localhost:3003
REALTIME_API_URL=http://localhost:3004
AUDIT_API_URL=http://localhost:3005
MCP_API_URL=http://localhost:3006
GATEWAY_CORS_ORIGINS=http://localhost:5173

# --- Insights remote (Module Federation) ---
INSIGHTS_REMOTE_ENTRY=http://localhost:5174/remoteEntry.js

# --- observabilidade ---
GATEWAY_UPSTREAM_KEEPALIVE=true
METRICS_TOKEN=
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=axial-ms-projects
